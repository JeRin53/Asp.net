@model AdvanceWebApplication.Models.LoginCls
@{
    ViewBag.Title = "Login_Pageload";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Login_Pageload</h2>
<div>
    @using (Html.BeginForm("Login_Click", "LoginDB", FormMethod.Post))
    {
        <div>
            <label>Name:</label>
        </div>
        <div>
            @Html.TextBoxFor(m => m.Uname)//multiline
            @Html.ValidationMessageFor(m => m.Uname)
        </div>
        <div>
            <label>Password:</label>
        </div>
        <div>
            @Html.PasswordFor(m => m.password)
            @Html.ValidationMessageFor(m => m.password)
        </div>

        <div>
            <input type="submit" value="Login" />
        </div>
    }
</div>


