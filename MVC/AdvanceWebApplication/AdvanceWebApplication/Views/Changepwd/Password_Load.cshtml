@model AdvanceWebApplication.Models.PwdCls
@{
    ViewBag.Title = "Password_Load";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Password_Load</h2>
<div>
    @using (Html.BeginForm("Password_Update", "Changepwd", FormMethod.Post))
    {
        <div>
            <label>Old Pass:</label>
        </div>
        <div>
            @Html.TextBoxFor(m => m.oldpass)
            @Html.ValidationMessageFor(m => m.oldpass)
        </div>

        <div>
            <label>New Pass:</label>
        </div>
        <div>
            @Html.TextBoxFor(m => m.newpass)
            @Html.ValidationMessageFor(m => m.newpass)
        </div>


        <div>
            <label>Confirm Pass:</label>
        </div>
        <div>
            @Html.TextBoxFor(m => m.confnewpass)
            @Html.ValidationMessageFor(m => m.confnewpass)
        </div>

        <div>
            <input type="submit" value="Update" />
            @Html.DisplayFor(m => m.msg)
        </div>
        <div>
            @Html.ActionLink("Back to Home Page", "Home", "LoginDB")
        </div>
    }
</div>

