        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <FunctionImportMapping FunctionImportName="sp_adminReg" FunctionName="MVCmultiuserModel.Store.sp_adminReg" />
    <FunctionImportMapping FunctionImportName="sp_LoginCountId" FunctionName="MVCmultiuserModel.Store.sp_LoginCountId" />
    <FunctionImportMapping FunctionImportName="sp_LoginId" FunctionName="MVCmultiuserModel.Store.sp_LoginId" />
    <FunctionImportMapping FunctionImportName="sp_Loginsert" FunctionName="MVCmultiuserModel.Store.sp_Loginsert" />
    <FunctionImportMapping FunctionImportName="sp_LoginType" FunctionName="MVCmultiuserModel.Store.sp_LoginType" />
    <FunctionImportMapping FunctionImportName="sp_MaxIdLogin" FunctionName="MVCmultiuserModel.Store.sp_MaxIdLogin" />
    <FunctionImportMapping FunctionImportName="sp_UserReg" FunctionName="MVCmultiuserModel.Store.sp_UserReg" />
  </EntityContainerMapping>
</Mapping>