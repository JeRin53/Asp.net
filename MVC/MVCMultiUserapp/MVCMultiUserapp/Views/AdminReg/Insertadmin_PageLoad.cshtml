@model MVCMultiUserapp.Models.AdminInsert
@{
    ViewBag.Title = "Insertadmin_PageLoad";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Insertadmin_PageLoad</h2>
<div>
    @using (Html.BeginForm("Insertadmin_Click", "AdminReg", FormMethod.Post))
    {
        <div>
            <label>Name:</label>
        </div>
        <div>
            @Html.TextAreaFor(m => m.Name)
            @Html.ValidationMessageFor(m => m.Name)
        </div>

        <div>
            <label>Address:</label>
        </div>
        <div>
            @Html.TextAreaFor(m => m.Address)
            @Html.ValidationMessageFor(m => m.Address)
        </div>


        <div>
            <label>Phone:</label>
        </div>
        <div>
            @Html.TextAreaFor(m => m.Phone)
            @Html.ValidationMessageFor(m => m.Phone)
        </div>


        <div>
            <label>Email:</label>
        </div>
        <div>
            @Html.TextAreaFor(m => m.Email)
            @Html.ValidationMessageFor(m => m.Email)
        </div>

        <div>
            <label>Username:</label>
        </div>
        <div>
            @Html.TextAreaFor(m => m.Username)
            @Html.ValidationMessageFor(m => m.Username)
        </div>

        <div>
            <label>Password:</label>
        </div>
        <div>
            @Html.PasswordFor(m => m.Pass)
        </div>

        <div>
            <label>Confirm Pass:</label>
        </div>
        <div>
            @Html.PasswordFor(m => m.Cpass)
            @Html.ValidationMessageFor(m => m.Cpass)
        </div>

        <div>
            <input id="01" type="submit" value="Register" />
            @Html.DisplayFor(m=>m.Adminmsg)
        </div>
    }
</div>


